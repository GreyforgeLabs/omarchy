#!/bin/bash

# omarchy:summary=Remove the Microsoft Outlook, Office, and Teams web apps.

set -e

for app in "Microsoft Outlook" "Microsoft Office" "Microsoft Teams"; do
  if [[ -f "$HOME/.local/share/applications/$app.desktop" ]]; then
    omarchy-webapp-remove "$app"
  fi
done

echo ""
echo "Microsoft Outlook, Office, and Teams have been removed."
