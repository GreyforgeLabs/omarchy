#!/bin/bash

# omarchy:summary=Install Microsoft Outlook, Office, and Teams as web apps.

set -e

ICONS="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png"

echo "Installing Microsoft Outlook..."
omarchy-webapp-install "Microsoft Outlook" "https://outlook.office.com/mail/" "$ICONS/microsoft-outlook.png"

echo "Installing Microsoft Office..."
omarchy-webapp-install "Microsoft Office" "https://www.office.com/login" "$ICONS/microsoft-office.png"

echo "Installing Microsoft Teams..."
omarchy-webapp-install "Microsoft Teams" "https://teams.microsoft.com/" "$ICONS/microsoft-teams.png"

echo ""
echo "You can now find Microsoft Outlook, Office, and Teams using the app launcher (SUPER + SPACE)"
